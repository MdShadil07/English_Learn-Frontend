# Frontend environment example
# Point all browser traffic at the API tier, not the inference service directly.
VITE_API_URL=http://localhost:5000/api
# Explicit WebSocket / socket.io base URL (same server, no /api suffix).
# IMPORTANT: Set this in production e.g. VITE_SOCKET_URL=https://api.myapp.com
VITE_SOCKET_URL=http://localhost:5000

# Room / WebSocket services
VITE_SFU_URL=http://localhost:3001

# Authentication and platform integrations
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=
VITE_GEMINI_API_KEY=

# Supabase client-side values used by existing frontend features
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional compatibility value used by some older utilities
VITE_API_BASE_URL=http://localhost:5000
